{
  "name": "narrated-incident-deck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "dev": "pnpm generate && slidev --port 3030",
    "build": "pnpm generate && slidev build --base /elevenlabs-hackathon/",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "export:png": "slidev export --format png --with-clicks --output .qa/export --wait 250",
    "test:browser": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@slidev/types": "53.0.0",
    "@types/file-saver": "2.0.7",
    "playwright-chromium": "1.56.1",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vue-tsc": "3.1.1"
  }
}
