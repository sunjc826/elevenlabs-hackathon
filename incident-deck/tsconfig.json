{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "global-bottom.vue",
    "layouts/**/*.vue",
    "setup/**/*.ts",
    "env.d.ts"
  ]
}
